<Window x:Class="PersonalTaskManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PersonalTaskManagement.ViewModels"
        xmlns:controls="clr-namespace:PersonalTaskManagement.Views.Controls"
        xmlns:conv="clr-namespace:PersonalTaskManagement.Converters"
        mc:Ignorable="d"
        Title="AgileFlow"
        Height="720" Width="1200"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NotNullVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVis" Invert="True"/>
        <conv:StringToAccentBrushConverter x:Key="AccentBrush"/>
        <!-- FlatButton, PrimaryButton, SecondaryButton, DangerButton, ColumnHeader
             and design tokens are defined globally in App.xaml. -->

        <!-- Search field: rounded, highlights on focus -->
        <Style x:Key="SearchBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SubtleBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource FocusBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Circular icon button for column header add -->
        <Style x:Key="IconCircleButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== Top bar ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                Padding="18,12" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#12000000" BlurRadius="8" ShadowDepth="1" Direction="270"/>
            </Border.Effect>
            <DockPanel LastChildFill="True">
                <!-- Brand + board controls -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource PrimaryBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="✓" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AgileFlow" FontSize="19" FontWeight="Bold" Foreground="#111827"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>

                    <Border Width="1" Background="{StaticResource BorderBrushColor}" Margin="16,4"/>

                    <ComboBox ItemsSource="{Binding Boards}"
                              SelectedItem="{Binding CurrentBoard, Mode=TwoWay}"
                              Style="{StaticResource InputComboBox}"
                              ItemContainerStyle="{StaticResource InputComboBoxItem}"
                              MinWidth="190" Height="36"
                              VerticalAlignment="Center"
                              FontWeight="SemiBold">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="＋ Board" Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                            ToolTip="Create a new board"
                            Command="{Binding AddBoardCommand}"/>
                    <Button Content="Rename" Style="{StaticResource FlatButton}"
                            ToolTip="Rename current board"
                            Command="{Binding RenameBoardCommand}"/>
                    <Button Content="Delete" Style="{StaticResource FlatButton}" Foreground="{StaticResource DangerBrush}"
                            ToolTip="Delete current board"
                            Command="{Binding DeleteBoardCommand}"/>
                </StackPanel>

                <!-- Add column -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋ Column" Style="{StaticResource PrimaryButton}"
                            Padding="14,7" MinHeight="36"
                            Command="{Binding AddColumnCommand}"/>
                </StackPanel>

                <!-- Search -->
                <Grid HorizontalAlignment="Stretch" Margin="20,0">
                    <Border Style="{StaticResource SearchBox}" MaxWidth="440" MinWidth="220" HorizontalAlignment="Center">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="✕" Width="20" Height="20" FontSize="11"
                                    Style="{StaticResource FlatButton}" Padding="0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding SearchQuery, Converter={StaticResource NotNullVis}}"/>
                            <Grid>
                                <TextBox x:Name="SearchInput"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                         FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource PrimaryBrush}"
                                         ToolTip="Search by title, description, or tag"/>
                                <TextBlock Text="Search tasks…" Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="18,7">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Left" Width="8" Height="8" CornerRadius="4"
                        Background="#22C55E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LicenseSummary}" Foreground="#1E40AF"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- ===================== Board area ===================== -->
        <Grid>
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding CurrentBoard, Converter={StaticResource NullVis}}">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <TextBlock Text="📋" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No board yet" FontSize="16" FontWeight="SemiBold" Foreground="#374151"
                           HorizontalAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock Text="Create a board to start organizing your tasks."
                           FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Button Content="＋ Create Board" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Center" Margin="0,16,0,0"
                        Command="{Binding AddBoardCommand}"/>
            </StackPanel>

            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="{Binding CurrentBoard, Converter={StaticResource NotNullVis}}">
                <ItemsControl ItemsSource="{Binding CurrentBoard.Columns}" Margin="18,18,18,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ColumnViewModel}">
                            <Border Width="300" Margin="0,0,14,0"
                                    Background="#EEF0F3"
                                    CornerRadius="10">
                                <DockPanel LastChildFill="True">
                                    <!-- Colored accent strip -->
                                    <Border DockPanel.Dock="Top" Height="4" CornerRadius="10,10,0,0"
                                            Background="{Binding Name, Converter={StaticResource AccentBrush}}"/>
                                    <!-- Column header -->
                                    <Border DockPanel.Dock="Top" Padding="14,11,14,10"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Rename Column"
                                                          Command="{Binding PlacementTarget.Tag.RenameColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="✎" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator/>
                                                <MenuItem Header="Delete Column" Style="{StaticResource DangerMenuItem}"
                                                          Command="{Binding PlacementTarget.Tag.DeleteColumnCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="🗑" FontSize="13"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <DockPanel LastChildFill="True">
                                            <Button DockPanel.Dock="Right"
                                                    Content="＋"
                                                    Style="{StaticResource IconCircleButton}"
                                                    ToolTip="Add task"
                                                    Command="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding Name, Converter={StaticResource AccentBrush}}"/>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource ColumnHeader}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="164" VerticalAlignment="Center"/>
                                                <Border CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                                        MinWidth="20" VerticalAlignment="Center"
                                                        Background="{Binding Name, Converter={StaticResource AccentBrush}}">
                                                    <TextBlock Text="{Binding Tasks.Count}" Foreground="White"
                                                               FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Tasks -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  AllowDrop="True"
                                                  PreviewDragOver="Column_DragOver"
                                                  Drop="Column_Drop"
                                                  Tag="{Binding}">
                                        <Grid>
                                            <!-- Empty-column drop hint -->
                                            <Border Margin="10,4,10,10" CornerRadius="8" MinHeight="90"
                                                    BorderBrush="#CBD2DA" BorderThickness="1.5"
                                                    Background="#00000000" IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Drop tasks here"
                                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <ItemsControl ItemsSource="{Binding TasksView}"
                                                          Padding="10,4,10,10"
                                                          Tag="{Binding}"
                                                          MinHeight="60"
                                                          Background="Transparent">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:TaskViewModel}">
                                                        <ContentControl PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                                                        PreviewMouseMove="Card_PreviewMouseMove"
                                                                        MouseDoubleClick="Card_MouseDoubleClick"
                                                                        Cursor="Hand"
                                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <ContentControl.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="Edit Task" InputGestureText="Dbl-click"
                                                                              Command="{Binding PlacementTarget.Tag.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                        <MenuItem.Icon>
                                                                            <TextBlock Text="✎" FontSize="14"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Header="Delete Task" Style="{StaticResource DangerMenuItem}"
                                                                              Command="{Binding PlacementTarget.Tag.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                                        <MenuItem.Icon>
                                                                            <TextBlock Text="🗑" FontSize="13"/>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                </ContextMenu>
                                                            </ContentControl.ContextMenu>
                                                            <controls:TaskCard/>
                                                        </ContentControl>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
