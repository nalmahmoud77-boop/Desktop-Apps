<Window x:Class="PersonalTaskManagement.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Activate AgileFlow"
        Height="640" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        ShowInTaskbar="True">
    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="28,22">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                    <TextBlock Text="✓" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Activate AgileFlow" Style="{StaticResource DialogTitle}"/>
                    <TextBlock Text="Enter your license key to unlock the app."
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="28,16">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Quit" Style="{StaticResource SecondaryButton}"
                        MinWidth="96" Click="Quit_Click"/>
                <Button DockPanel.Dock="Right" Content="Activate" Style="{StaticResource PrimaryButton}"
                        MinWidth="120" Click="Activate_Click"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,22">
            <StackPanel>

                <!-- Current status -->
                <Border x:Name="StatusBanner" CornerRadius="8" Padding="14,12" Background="#EFF6FF"
                        BorderBrush="#BFDBFE" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1E3A8A" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ClockWarn" Visibility="Collapsed" Margin="0,6,0,0"
                                   FontSize="12" Foreground="#B45309" TextWrapping="Wrap"
                                   Text="⚠ The system clock appears to have been changed. Time-limited licenses are validated against a tamper-protected clock."/>
                    </StackPanel>
                </Border>

                <!-- Tiers -->
                <TextBlock Text="Available editions" Style="{StaticResource FieldLabel}" Margin="0,20,0,8"/>
                <UniformGrid Columns="3">
                    <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}" Margin="0,0,8,0"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Monthly" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="30 days" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="{StaticResource SurfaceBrush}" Margin="4,0,4,0"
                            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Yearly" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="365 days" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="8" Background="#EFF6FF" Margin="8,0,0,0"
                            BorderBrush="#BFDBFE" BorderThickness="1" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Full" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Lifetime" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Machine ID -->
                <TextBlock Text="Your machine ID" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                <TextBlock Text="Share this with your vendor so they can issue a key bound to this computer."
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButton}"
                            MinWidth="72" Margin="8,0,0,0" Click="CopyMachineId_Click"/>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Padding="10,8">
                        <TextBlock x:Name="MachineIdText" FontFamily="Consolas" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>

                <!-- Key entry -->
                <TextBlock Text="License key" Style="{StaticResource FieldLabel}" Margin="0,20,0,6"/>
                <TextBox x:Name="KeyBox" Style="{StaticResource InputTextBox}"
                         MinHeight="88" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"/>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
