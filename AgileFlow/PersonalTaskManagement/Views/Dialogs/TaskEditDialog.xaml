<Window x:Class="PersonalTaskManagement.Views.Dialogs.TaskEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PersonalTaskManagement.Converters"
        xmlns:models="clr-namespace:PersonalTaskManagement.Models"
        Title="Task"
        Height="620" Width="600"
        MinHeight="480" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexBrush"/>

        <!-- Segmented priority selector pill -->
        <Style x:Key="PriorityPill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Base" CornerRadius="8" Background="#F3F4F6"/>
                            <!-- color fill (shown when checked) -->
                            <Border x:Name="Fill" CornerRadius="8" Background="{TemplateBinding Background}" Opacity="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="9" Height="9" Margin="0,0,7,0"
                                         Fill="{TemplateBinding Background}"/>
                                <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Base" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                <Setter TargetName="Dot" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive tag toggle chip -->
        <Style x:Key="TagChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <!-- color fill (shown when checked) -->
                            <Border x:Name="Fill" CornerRadius="12" Background="{TemplateBinding Background}" Opacity="0"/>
                            <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                                    BorderThickness="1.5" BorderBrush="{TemplateBinding Background}"
                                    Padding="11,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Check" Text="✓" FontSize="11" FontWeight="Bold"
                                               Foreground="White" Margin="0,0,5,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="Txt" Text="{TemplateBinding Content}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Background}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="0.14"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="Txt" Property="Foreground" Value="White"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <DockPanel.RenderTransform>
            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
        </DockPanel.RenderTransform>
        <DockPanel.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.22">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </DockPanel.Triggers>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1"
                Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="22" CornerRadius="2" Background="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                <TextBlock x:Name="HeaderText" Text="Edit Task" Style="{StaticResource DialogTitle}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Footer actions -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        MinWidth="96" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}"
                        MinWidth="96" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TitleBox" Grid.Row="1" Style="{StaticResource InputTextBox}" Margin="0,0,0,16"/>

                <TextBlock Grid.Row="2" Text="Description" Style="{StaticResource FieldLabel}"/>
                <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6"
                        MinHeight="150">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource SubtleBrush}"
                                BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0" Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="EditingCommands.ToggleBold" ToolTip="Bold"
                                        Style="{StaticResource ToolbarButton}" FontWeight="Bold" Content="B"/>
                                <Button Command="EditingCommands.ToggleItalic" ToolTip="Italic"
                                        Style="{StaticResource ToolbarButton}" FontStyle="Italic" Content="I"/>
                                <Button Command="EditingCommands.ToggleUnderline" ToolTip="Underline"
                                        Style="{StaticResource ToolbarButton}">
                                    <TextBlock Text="U" TextDecorations="Underline"/>
                                </Button>
                                <Border Width="1" Background="{StaticResource BorderStrongBrush}" Margin="4,3"/>
                                <Button Command="EditingCommands.ToggleBullets" ToolTip="Bullet list"
                                        Style="{StaticResource ToolbarButton}" Content="•"/>
                                <Button Command="EditingCommands.ToggleNumbering" ToolTip="Numbered list"
                                        Style="{StaticResource ToolbarButton}" Content="1."/>
                            </StackPanel>
                        </Border>
                        <RichTextBox x:Name="DescriptionBox"
                                     BorderThickness="0"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Padding="10,8"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Priority" Style="{StaticResource FieldLabel}"/>
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="PrioLow" Content="Low" GroupName="Priority"
                                         Style="{StaticResource PriorityPill}" Background="#16A34A" Margin="0,0,3,0"/>
                            <RadioButton x:Name="PrioMedium" Content="Medium" GroupName="Priority"
                                         Style="{StaticResource PriorityPill}" Background="#D97706" Margin="3,0,3,0"/>
                            <RadioButton x:Name="PrioHigh" Content="High" GroupName="Priority"
                                         Style="{StaticResource PriorityPill}" Background="#DC2626" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Clear"
                                    Style="{StaticResource FlatButton}" Padding="8,2"
                                    Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                    Click="ClearDate_Click"/>
                            <TextBlock Text="Due Date" Style="{StaticResource FieldLabel}" Margin="0"/>
                        </DockPanel>
                        <DatePicker x:Name="DueDatePicker" Height="34" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="5" Text="Tags" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                <Border Grid.Row="6" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="10" MinHeight="44">
                    <ItemsControl x:Name="TagsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource TagChip}" Margin="0,0,8,8"
                                              Background="{Binding Tag.ColorHex, Converter={StaticResource HexBrush}}"
                                              Content="{Binding Tag.Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
