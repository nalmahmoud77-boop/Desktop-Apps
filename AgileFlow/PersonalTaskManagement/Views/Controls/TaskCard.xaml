<UserControl x:Class="PersonalTaskManagement.Views.Controls.TaskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PersonalTaskManagement.ViewModels"
             xmlns:conv="clr-namespace:PersonalTaskManagement.Converters"
             xmlns:models="clr-namespace:PersonalTaskManagement.Models"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TaskViewModel}"
             d:DesignWidth="260">
    <UserControl.Resources>
        <conv:PriorityToBrushConverter x:Key="PriorityBrush"/>
        <conv:PriorityToBackgroundConverter x:Key="PriorityBackground"/>
        <conv:PriorityLabelConverter x:Key="PriorityLabel"/>
        <conv:DueDateToBrushConverter x:Key="DueBrush"/>
        <conv:DueDateToTextConverter x:Key="DueText"/>
        <conv:HexToBrushConverter x:Key="HexBrush"/>
        <conv:NullToVisibilityConverter x:Key="NotNullVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Border x:Name="CardRoot" CornerRadius="8"
            Background="White"
            BorderThickness="1"
            BorderBrush="#E5E7EB"
            Padding="0"
            Margin="0,0,0,10"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <TranslateTransform Y="0"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" Color="#22000000" BlurRadius="6" ShadowDepth="1" Direction="270"/>
        </Border.Effect>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-3" Duration="0:0:0.14">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="16" Duration="0:0:0.14"/>
                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="ShadowDepth" To="4" Duration="0:0:0.14"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Border.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="BlurRadius" To="6" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="CardShadow" Storyboard.TargetProperty="ShadowDepth" To="1" Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{Binding Priority, Converter={StaticResource PriorityBrush}}"
                    CornerRadius="8,0,0,8"/>

            <StackPanel Grid.Column="1" Margin="13,11,13,11">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right"
                            Background="{Binding Priority, Converter={StaticResource PriorityBackground}}"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Top"
                            Margin="8,0,0,0">
                        <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityLabel}}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{Binding Priority, Converter={StaticResource PriorityBrush}}"/>
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               FontWeight="SemiBold"
                               FontSize="13.5"
                               LineHeight="18"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               Foreground="#111827"/>
                </DockPanel>

                <TextBlock Text="{Binding DescriptionPreview}"
                           FontSize="11.5"
                           Foreground="#6B7280"
                           Margin="0,5,0,0"
                           LineHeight="16"
                           TextWrapping="Wrap"
                           Visibility="{Binding DescriptionPreview, Converter={StaticResource NotNullVis}}"/>

                <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0"
                              Visibility="{Binding Tags.Count, Converter={StaticResource NotNullVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Tag}">
                            <Border Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="0,0,5,5">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,8,0,0" LastChildFill="False"
                           Visibility="{Binding DueDate, Converter={StaticResource NotNullVis}}">
                    <Border DockPanel.Dock="Left"
                            CornerRadius="10"
                            Padding="8,2"
                            Background="{Binding DueDate, Converter={StaticResource DueBrush}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗓" FontSize="10" Foreground="White" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DueDate, Converter={StaticResource DueText}}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Left"
                            Margin="6,0,0,0"
                            Padding="8,2"
                            CornerRadius="10"
                            Background="#FEE2E2"
                            Visibility="{Binding IsOverdue, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="OVERDUE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="#B91C1C"/>
                    </Border>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
