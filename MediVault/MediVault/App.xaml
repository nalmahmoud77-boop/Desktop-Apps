<Application x:Class="MediVault.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MediVault"
             xmlns:conv="clr-namespace:MediVault.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisInvert" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVis" />
            <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringToVis" />
            <conv:EnumToBoolConverter x:Key="EnumToBool" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:InitialsConverter x:Key="Initials" />
            <conv:GenderToBrushConverter x:Key="GenderToBrush" />
            <conv:CountToBoolConverter x:Key="CountToBool" />
            <conv:ActiveToBrushConverter x:Key="ActiveToBrush" />
            <conv:ActiveToLabelConverter x:Key="ActiveToLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
