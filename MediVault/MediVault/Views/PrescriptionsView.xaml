<UserControl x:Class="MediVault.Views.PrescriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MediVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PrescriptionsViewModel}"
             FontFamily="Segoe UI">

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Prescription list -->
        <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,20,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Prescriptions" Style="{StaticResource SubheadingText}" />
                        <TextBlock Text="Issued by physicians" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ New" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Padding="12,8" />
                </Grid>

                <ListBox Grid.Row="1"
                         Style="{StaticResource CleanListBox}"
                         ItemsSource="{Binding Prescriptions}"
                         SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource PatientListItem}"
                         Padding="12,0,12,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#EEF4FF">
                                    <TextBlock Text="℞" FontSize="20" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding Patient.FullName}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding IssuedOn, StringFormat='{}{0:MMM d}'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right area -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <!-- Detail (read-only) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCreating}" Value="False" />
                                        <Condition Binding="{Binding HasSelected}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Selected.Code}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Foreground="{StaticResource TextMutedBrush}">
                                    <Run Text="Issued " />
                                    <Run Text="{Binding Selected.IssuedOn, StringFormat='{}{0:dddd, MMMM d, yyyy HH:mm}'}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="🖶 Print" Style="{StaticResource SecondaryButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0" />
                                <Button Content="↓ Save XPS / PDF" Style="{StaticResource PrimaryButton}" Command="{Binding ExportPdfCommand}" Margin="0,0,8,0" />
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Padding="20" Background="{StaticResource CardAccentGradient}" CornerRadius="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PATIENT" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding Selected.Patient.FullName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding Selected.Patient.MedicalId}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                        <Run Text=" • Age " />
                                        <Run Text="{Binding Selected.Patient.Age}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DOCTOR" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding Selected.Doctor.FullName}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Selected.Doctor.Specialty}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Padding="16" Background="#F8FAFC" CornerRadius="10" Margin="0,0,0,16"
                                Visibility="{Binding Selected.Diagnosis, Converter={StaticResource StringToVis}}">
                            <StackPanel>
                                <TextBlock Text="DIAGNOSIS" Style="{StaticResource LabelText}" />
                                <TextBlock Text="{Binding Selected.Diagnosis}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Medications" Style="{StaticResource SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding Selected.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="10" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#EEF4FF">
                                                <TextBlock Text="💊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                                    <Run Text="{Binding Medication.Name}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Medication.Strength}" />
                                                </TextBlock>
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                                    <Run Text="{Binding Dosage}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding Frequency}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding Duration}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Instructions}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontStyle="Italic" Margin="0,2,0,0"
                                                           Visibility="{Binding Instructions, Converter={StaticResource StringToVis}}" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding Quantity, StringFormat='Qty: {0}'}" Style="{StaticResource PillText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="16" Background="#FFFBEB" BorderBrush="#FCD34D" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0"
                                Visibility="{Binding Selected.Notes, Converter={StaticResource StringToVis}}">
                            <StackPanel>
                                <TextBlock Text="NOTES" Style="{StaticResource LabelText}" Foreground="#92400E" />
                                <TextBlock Text="{Binding Selected.Notes}" Foreground="#78350F" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Empty -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelected}" Value="False" />
                                        <Condition Binding="{Binding IsCreating}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="80" Height="80" CornerRadius="40" Background="#EEF4FF" HorizontalAlignment="Center">
                        <TextBlock Text="℞" FontSize="36" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Select a prescription" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Choose one from the list, or click + New to issue a new prescription." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,16" />
                    <Button Content="+ New prescription" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Create -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="New prescription" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="Issue a digital prescription" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                                <Button Content="Issue" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Visibility="{Binding ValidationErrors, Converter={StaticResource StringToVis}}"
                                Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <TextBlock Text="{Binding ValidationErrors}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="PATIENT" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" DisplayMemberPath="FullName" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="DOCTOR" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding Doctors}" SelectedItem="{Binding SelectedDoctor}" DisplayMemberPath="FullName" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="DIAGNOSIS" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Medications" Style="{StaticResource SubheadingText}" />
                            <Button Grid.Column="1" Content="+ Add medication" Style="{StaticResource SecondaryButton}" Command="{Binding AddItemCommand}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14" Margin="0,0,0,8" CornerRadius="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding DataContext.Medications, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Medication}"
                                                          DisplayMemberPath="Name" />
                                                <Button Grid.Column="1" Content="✕"
                                                        Style="{StaticResource GhostIconButton}"
                                                        Margin="8,0,0,0"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="DOSAGE" Style="{StaticResource LabelText}" />
                                                    <TextBox Text="{Binding Dosage, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                    <TextBlock Text="FREQUENCY" Style="{StaticResource LabelText}" />
                                                    <TextBox Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                                    <TextBlock Text="DURATION" Style="{StaticResource LabelText}" />
                                                    <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Margin="8,0,0,0">
                                                    <TextBlock Text="QUANTITY" Style="{StaticResource LabelText}" />
                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Margin="0,8,0,0">
                                                <TextBlock Text="INSTRUCTIONS" Style="{StaticResource LabelText}" />
                                                <TextBox Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="ADDITIONAL NOTES" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalContentAlignment="Top" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
