<Window x:Class="MediVault.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MediVault — Sign In"
        Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border CornerRadius="18" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#1E293B" Opacity="0.25" BlurRadius="40" ShadowDepth="6" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left brand panel -->
            <Border Grid.Column="0" CornerRadius="18,0,0,18" Background="{StaticResource LoginGradient}">
                <Grid Margin="48,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#22D3EE">
                            <TextBlock Text="❤" Foreground="#0F172A" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MediVault" Foreground="White" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="Patient Records &amp; Care" Foreground="#A5B4FC" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="Care, organized."
                                   Foreground="White" FontSize="42" FontWeight="Bold"
                                   TextWrapping="Wrap" LineHeight="48" />
                        <TextBlock Text="A secure home for patient records, appointments, prescriptions and audit trails — built for clinicians who care about the details."
                                   Foreground="#CBD5F5" FontSize="15"
                                   TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="24" MaxWidth="420" HorizontalAlignment="Left" />

                        <StackPanel Margin="0,32,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#22D3EE" VerticalAlignment="Center">
                                    <TextBlock Text="✓" Foreground="#0F172A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Encrypted password storage with BCrypt" Foreground="#E2E8F0" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#22D3EE" VerticalAlignment="Center">
                                    <TextBlock Text="✓" Foreground="#0F172A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Real-time appointment conflict detection" Foreground="#E2E8F0" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#22D3EE" VerticalAlignment="Center">
                                    <TextBlock Text="✓" Foreground="#0F172A" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Read-only audit log of every change" Foreground="#E2E8F0" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="© MediVault 2026" Foreground="#94A3B8" FontSize="11" />
                </Grid>
            </Border>

            <!-- Right login panel -->
            <Grid Grid.Column="1" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Window controls -->
                <Grid Grid.Row="0" Margin="0,12,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="Transparent" Height="34" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Panel.ZIndex="2">
                        <Button x:Name="MinimizeBtn" Style="{StaticResource GhostIconButton}" Content="—" Click="MinimizeBtn_Click" />
                        <Button x:Name="CloseBtn" Style="{StaticResource GhostIconButton}" Content="✕" Click="CloseBtn_Click" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="50,0,50,40" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Welcome back" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Sign in to your MediVault account" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,28" />

                        <TextBlock Text="USERNAME" Style="{StaticResource LabelText}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                        <TextBlock Text="PASSWORD" Style="{StaticResource LabelText}" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" KeyDown="PasswordBox_KeyDown" />

                        <TextBlock Text="{Binding Error}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,4,0,12"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource StringToVis}}" />

                        <Button Content="Sign in"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoginCommand}"
                                Click="Login_Click"
                                Margin="0,12,0,0" />

                        <Border Margin="0,28,0,0" Background="#F8FAFC" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Demo accounts" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0">
                                    Admin — <Run FontWeight="SemiBold">admin / admin123</Run>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                    Doctor — <Run FontWeight="SemiBold">doctor / doctor123</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>

        </Grid>
    </Border>
</Window>
