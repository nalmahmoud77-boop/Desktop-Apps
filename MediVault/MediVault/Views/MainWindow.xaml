<Window x:Class="MediVault.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MediVault.ViewModels"
        xmlns:views="clr-namespace:MediVault.Views"
        Title="MediVault"
        Height="820" Width="1320"
        MinHeight="700" MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientsViewModel}">
            <views:PatientsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppointmentsViewModel}">
            <views:AppointmentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionsViewModel}">
            <views:PrescriptionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <views:AuditLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PermissionsViewModel}">
            <views:PermissionsView />
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="14" Background="{StaticResource BackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect Color="#1E293B" Opacity="0.18" BlurRadius="30" ShadowDepth="4" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" CornerRadius="14,0,0,14" Background="{StaticResource SidebarGradient}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,28,22,30">
                        <Border Width="38" Height="38" CornerRadius="10" Background="#22D3EE">
                            <TextBlock Text="❤" Foreground="#0F172A" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MediVault" Foreground="White" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Patient Care" Foreground="#94A3B8" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="MAIN MENU" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="32,0,0,8" />

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="{Binding IsDashboard, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◐" FontSize="16" Width="22" />
                                <TextBlock Text="Dashboard" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Visibility="{Binding CanViewPatients, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding IsPatients, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Patients">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="❤" FontSize="16" Width="22" />
                                <TextBlock Text="Patients" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Visibility="{Binding CanViewAppointments, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding IsAppointments, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Appointments">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◷" FontSize="16" Width="22" />
                                <TextBlock Text="Appointments" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Visibility="{Binding CanViewPrescriptions, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding IsPrescriptions, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Prescriptions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="℞" FontSize="16" Width="22" />
                                <TextBlock Text="Prescriptions" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Visibility="{Binding CanViewAuditLog, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding IsAuditLog, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="AuditLog">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="≣" FontSize="16" Width="22" />
                                <TextBlock Text="Audit Log" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                     Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVis}}"
                                     IsChecked="{Binding IsPermissions, Mode=OneWay}"
                                     Command="{Binding NavigateCommand}"
                                     CommandParameter="Permissions">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚷" FontSize="16" Width="22" />
                                <TextBlock Text="Permissions" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- User panel -->
                    <Border Grid.Row="2" Margin="16,0,16,16" Padding="14" CornerRadius="12" Background="#1E293B">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryGradient}">
                                    <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding CurrentUserRole}" Foreground="#94A3B8" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Sign out"
                                    Margin="0,12,0,0"
                                    Command="{Binding LogoutCommand}"
                                    Background="#0F172A"
                                    Foreground="#E2E8F0"
                                    BorderThickness="1"
                                    BorderBrush="#334155"
                                    Padding="10,8"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="#1E293B" />
                                                <Setter TargetName="b" Property="BorderBrush" Value="#64748B" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0" Background="White" Padding="32,18" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SectionTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="MediVault • Patient Record &amp; Appointment Manager" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="LicenseBadgeToggle"
                                          Margin="0,0,12,0"
                                          Cursor="Hand"
                                          Visibility="{Binding HasLicense, Converter={StaticResource BoolToVis}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="badge"
                                                Background="#F1F5F9"
                                                CornerRadius="999"
                                                Padding="14,8"
                                                BorderThickness="1"
                                                BorderBrush="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="tier" Text="{Binding LicenseTierLabel}" Margin="8,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="·" Margin="0,0,6,0" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="days" Text="{Binding LicenseDaysLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding LicenseIsExpiringSoon}" Value="True">
                                                <Setter TargetName="badge" Property="Background" Value="#FEF2F2" />
                                                <Setter TargetName="badge" Property="BorderBrush" Value="#FCA5A5" />
                                                <Setter TargetName="dot" Property="Fill" Value="{StaticResource DangerBrush}" />
                                                <Setter TargetName="tier" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter TargetName="days" Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="badge" Property="Background" Value="#E2E8F0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding ElementName=LicenseBadgeToggle}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsChecked, ElementName=LicenseBadgeToggle, Mode=TwoWay}">
                                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,8,8,12"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="320">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#1E293B" Opacity="0.18" BlurRadius="20" ShadowDepth="3" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="License" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding LicenseTierLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,12" />

                                        <Grid Margin="0,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Issued to" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicenseIssuedTo}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Issued at" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LicenseIssuedAtLocal}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expires" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,4" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicenseExpiresAtLocal}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LicenseStatusLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                        </Grid>

                                        <Button Content="Deactivate license"
                                                Margin="0,18,0,0"
                                                Padding="10,8"
                                                Cursor="Hand"
                                                Background="#FEF2F2"
                                                Foreground="{StaticResource DangerBrush}"
                                                BorderBrush="#FCA5A5"
                                                BorderThickness="1"
                                                Command="{Binding DeactivateLicenseCommand}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#FEE2E2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <Button x:Name="MinimizeBtn" Content="—" Style="{StaticResource GhostIconButton}" Click="Minimize_Click" />
                            <Button x:Name="MaximizeBtn" Content="▢" Style="{StaticResource GhostIconButton}" Click="Maximize_Click" />
                            <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource GhostIconButton}" Click="Close_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active view -->
                <ContentControl Grid.Row="1" Content="{Binding ActiveView}" />
            </Grid>
        </Grid>
    </Border>
</Window>
