<UserControl x:Class="MediVault.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MediVault.ViewModels"
             xmlns:models="clr-namespace:MediVault.Models"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PatientsViewModel}"
             FontFamily="Segoe UI">

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Patient list -->
        <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="20,20,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Patients" Style="{StaticResource SubheadingText}" />
                        <TextBlock Text="Manage records" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ New" Command="{Binding NewCommand}" Padding="12,8" />
                </Grid>

                <!-- Search -->
                <Border Grid.Row="1" Margin="20,0,20,12">
                    <Grid>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Padding="38,9,12,9" />
                        <TextBlock Text="🔍" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!-- List -->
                <ListBox Grid.Row="2"
                         Style="{StaticResource CleanListBox}"
                         ItemsSource="{Binding Patients}"
                         SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource PatientListItem}"
                         Padding="12,0,12,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{Binding Gender, Converter={StaticResource GenderToBrush}}">
                                    <TextBlock Text="{Binding FullName, Converter={StaticResource Initials}}" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding MedicalId}" Foreground="{StaticResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Age, StringFormat='{}{0} yrs'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                        <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding Gender}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Detail / Editor -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasSelected, Converter={StaticResource BoolToVisInvert}}">
                    <Border Width="80" Height="80" CornerRadius="40" Background="#EEF4FF" HorizontalAlignment="Center">
                        <TextBlock Text="❤" FontSize="36" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Select a patient" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="Choose a patient from the list to view or edit their record." Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <Button Content="+ Add new patient" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0,18,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Detail (read-only) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSelected}" Value="True" />
                                        <Condition Binding="{Binding IsEditing}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <!-- Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" Background="{Binding Selected.Gender, Converter={StaticResource GenderToBrush}}">
                                <TextBlock Text="{Binding Selected.FullName, Converter={StaticResource Initials}}" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.FullName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Selected.MedicalId}" Style="{StaticResource PillText}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="#DCFCE7" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Selected.Age, StringFormat='{}{0} years'}" Style="{StaticResource PillText}" Foreground="{StaticResource SuccessBrush}" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="#F3E8FF" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Selected.Gender}" Style="{StaticResource PillText}" Foreground="#7C3AED" />
                                    </Border>
                                    <Border Style="{StaticResource Pill}" Background="#FEE2E2">
                                        <TextBlock Text="{Binding Selected.BloodGroup, FallbackValue='—'}" Style="{StaticResource PillText}" Foreground="{StaticResource DangerBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                                <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,24,0,0" Padding="20" Background="#F8FAFC" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CONTACT" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="{Binding Selected.Phone}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Selected.Email, FallbackValue='—'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Selected.Address, FallbackValue='—'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="DETAILS" Style="{StaticResource LabelText}" />
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" FontSize="14">
                                        <Run Text="DOB:" Foreground="{StaticResource TextMutedBrush}" />
                                        <Run Text="{Binding Selected.DateOfBirth, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                    </TextBlock>
                                    <TextBlock Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0">
                                        <Run Text="Allergies:" Foreground="{StaticResource TextMutedBrush}" />
                                        <Run Text="{Binding Selected.Allergies, FallbackValue='None'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- History -->
                        <TextBlock Text="Medical history" Style="{StaticResource SectionTitle}" Margin="0,24,0,8" />
                        <Border Padding="16" Background="#F8FAFC" CornerRadius="10">
                            <TextBlock Text="{Binding Selected.MedicalHistory, FallbackValue='No medical history recorded.'}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>

                        <!-- Conditions M:M -->
                        <Grid Margin="0,28,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Conditions" Style="{StaticResource SectionTitle}" Margin="0" />
                        </Grid>

                        <Border Padding="16" Background="#F8FAFC" CornerRadius="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Margin="0,0,8,0"
                                          ItemsSource="{Binding AvailableConditions}"
                                          SelectedItem="{Binding SelectedCondition}"
                                          DisplayMemberPath="Name" />
                                <DatePicker Grid.Column="1" Margin="0,0,8,0" SelectedDate="{Binding NewDiagnosed}" />
                                <ComboBox Grid.Column="2" Margin="0,0,8,0" ItemsSource="{Binding Severities}" SelectedItem="{Binding NewSeverity}" />
                                <Button Grid.Column="3" Content="+ Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddConditionCommand}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PatientConditions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14" Margin="0,0,0,6" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Severity, Converter={StaticResource StatusToBrush}}" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Condition.Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding Condition.IcdCode}" />
                                                    <Run Text=" • Diagnosed " />
                                                    <Run Text="{Binding DiagnosedOn, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                                    <Run Text=" • Severity: " />
                                                    <Run Text="{Binding Severity}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource GhostIconButton}" Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Medications M:M -->
                        <TextBlock Text="Medications" Style="{StaticResource SectionTitle}" Margin="0,28,0,12" />
                        <Border Padding="16" Background="#F8FAFC" CornerRadius="10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" Margin="0,0,8,0"
                                          ItemsSource="{Binding AvailableMedications}"
                                          SelectedItem="{Binding SelectedMedication}"
                                          DisplayMemberPath="Name" />
                                <TextBox Grid.Column="1" Text="{Binding NewDosage, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <TextBox Grid.Column="2" Text="{Binding NewFrequency, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                <DatePicker Grid.Column="3" SelectedDate="{Binding NewStart}" Margin="0,0,8,0" />
                                <Button Grid.Column="4" Content="+ Add" Style="{StaticResource PrimaryButton}" Command="{Binding AddMedicationCommand}" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding PatientMedications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14" Margin="0,0,0,6" Background="White" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#EEF4FF">
                                                <TextBlock Text="℞" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}">
                                                    <Run Text="{Binding Medication.Name}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding Medication.Strength}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding Dosage}" />
                                                    <Run Text=" • " />
                                                    <Run Text="{Binding Frequency}" />
                                                    <Run Text=" • Started " />
                                                    <Run Text="{Binding StartDate, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource GhostIconButton}" Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveMedicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Editor -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>

                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Edit patient" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter Property="Text" Value="New patient" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Fill in the details below" Style="{StaticResource MutedText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </Grid>

                        <Border Visibility="{Binding ValidationErrors, Converter={StaticResource StringToVis}}"
                                Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <TextBlock Text="{Binding ValidationErrors}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="MEDICAL ID" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.MedicalId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Format: MED-XXXXXX" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="BLOOD GROUP" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.BloodGroup, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="FIRST NAME" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.FirstName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="LAST NAME" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.LastName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="DATE OF BIRTH" Style="{StaticResource LabelText}" />
                                <DatePicker SelectedDate="{Binding Editing.DateOfBirth}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="GENDER" Style="{StaticResource LabelText}" />
                                <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Editing.Gender}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,12">
                                <TextBlock Text="PHONE" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.Phone, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="8,0,0,12">
                                <TextBlock Text="EMAIL" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.Email, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="ADDRESS" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.Address, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,8">
                                <TextBlock Text="MEDICAL HISTORY" Style="{StaticResource LabelText}" />
                                <TextBox Text="{Binding Editing.MedicalHistory, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalContentAlignment="Top" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="ALLERGIES" Style="{StaticResource LabelText}" />
                            <TextBox Text="{Binding Editing.Allergies, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
