<UserControl x:Class="MediVault.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MediVault.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PermissionsViewModel}"
             FontFamily="Segoe UI">

    <Grid Margin="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: users list / editor -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0">
            <Grid>
                <!-- List -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="22,22,22,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Users" Style="{StaticResource SubheadingText}" />
                            <TextBlock Text="Accounts &amp; role assignment" Style="{StaticResource MutedText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="+ New" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Padding="12,8" />
                    </Grid>

                    <!-- List -->
                    <ListBox Grid.Row="1" Style="{StaticResource CleanListBox}"
                             ItemContainerStyle="{StaticResource PatientListItem}"
                             Margin="14,0,14,0"
                             ItemsSource="{Binding Users}"
                             SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource PrimaryGradient}">
                                        <TextBlock Text="{Binding FullName, Converter={StaticResource Initials}}" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                            <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center"
                                            Background="{Binding IsActive, Converter={StaticResource ActiveToBrush}}">
                                        <TextBlock Style="{StaticResource PillText}"
                                                   Foreground="White"
                                                   Text="{Binding IsActive, Converter={StaticResource ActiveToLabel}}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Selected actions -->
                    <Grid Grid.Row="2" Margin="22,12,22,20" Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Selected user" Style="{StaticResource LabelText}" />
                            <TextBlock Text="{Binding Selected.Username}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Edit" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Editor -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Edit user" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                            <Setter Property="Text" Value="New user" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Accounts authenticate with username + password" Style="{StaticResource MutedText}" Margin="0,0,0,16" />

                        <Border Visibility="{Binding ValidationErrors, Converter={StaticResource StringToVis}}"
                                Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,0,0,16">
                            <TextBlock Text="{Binding ValidationErrors}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="USERNAME" Style="{StaticResource LabelText}" />
                        <TextBox Text="{Binding Editing.Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="FULL NAME" Style="{StaticResource LabelText}" />
                        <TextBox Text="{Binding Editing.FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <TextBlock Text="ROLE" Style="{StaticResource LabelText}" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Editing.Role}" Margin="0,0,0,12" />

                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                                    <Setter Property="Text" Value="PASSWORD" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNew}" Value="False">
                                            <Setter Property="Text" Value="PASSWORD (LEAVE BLANK TO KEEP)" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,12" />

                        <CheckBox Content="Active" IsChecked="{Binding Editing.IsActive}" Margin="0,0,0,18"
                                  Foreground="{StaticResource TextPrimaryBrush}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- RIGHT: permission matrix -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="28,24,28,4">
                    <TextBlock Text="Role permissions" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Choose which sections each role can access. Administrators always have full access." Style="{StaticResource MutedText}" />
                </StackPanel>

                <!-- Column headers -->
                <Grid Grid.Row="1" Margin="28,16,28,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PERMISSION" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="ADMIN" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="DOCTOR" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="RECEPTIONIST" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                </Grid>

                <!-- Rows -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28,0,28,0">
                    <ItemsControl ItemsSource="{Binding Permissions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,12" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Admin, Mode=OneWay}" IsEnabled="False"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="2" IsChecked="{Binding Doctor}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <CheckBox Grid.Column="3" IsChecked="{Binding Receptionist}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Save -->
                <Border Grid.Row="3" Padding="28,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Button Content="Save permissions" Style="{StaticResource PrimaryButton}" Command="{Binding SavePermissionsCommand}" HorizontalAlignment="Right" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
