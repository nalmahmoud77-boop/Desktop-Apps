<Window x:Class="StoreApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:StoreApp.ViewModels"
        xmlns:views="clr-namespace:StoreApp.Views"
        Title="StoreApp" Height="780" Width="1280" MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        TextElement.Foreground="{StaticResource TextBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShopViewModel}">
            <views:ShopView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CartViewModel}">
            <views:CartView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="22,24,22,28">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryGradient}">
                        <TextBlock Text="🛒" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="StoreApp" Foreground="White" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Admin Console" Foreground="#94A3B8" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="MAIN" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="22,8,0,4" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" IsChecked="True" Command="{Binding ShowDashboardCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,12,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding ShowShopCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛍" Margin="0,0,12,0" />
                            <TextBlock Text="Shop" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="MANAGE" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="22,18,0,4" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding ShowProductsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" Margin="0,0,12,0" />
                            <TextBlock Text="Products" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding ShowOrdersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧾" Margin="0,0,12,0" />
                            <TextBlock Text="Orders" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding ShowCustomersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" Margin="0,0,12,0" />
                            <TextBlock Text="Customers" />
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="CHECKOUT" Foreground="#64748B" FontSize="10.5" FontWeight="Bold" Margin="22,18,0,4" />
                    <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Command="{Binding ShowCartCommand}">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" Margin="0,0,12,0" />
                                <TextBlock Text="Shopping Cart" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource AccentBrush}"
                                    CornerRadius="10" Padding="8,2" MinWidth="22"
                                    Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding CartItemsCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <!-- User card -->
                <Border Grid.Row="2" Margin="14,12" Padding="12" CornerRadius="10" Background="#1E293B">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryGradient}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRole}" Foreground="#94A3B8" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding LogoutCommand}" ToolTip="Sign out"
                                Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" Padding="6">
                            <TextBlock Text="↪" FontSize="16" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="68">
                        <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource HeadingText}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding ShowLicenseCommand}" Cursor="Hand" Margin="0,0,12,0"
                                Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                                ToolTip="View license details">
                            <Border CornerRadius="999" Padding="12,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#EEF2FF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicenseExpiringSoon}" Value="True">
                                                <Setter Property="Background" Value="#FEE2E2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔑" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LicenseStatus}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLicenseExpiringSoon}" Value="True">
                                                        <Setter Property="Foreground" Value="#B91C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ShowCartCommand}" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛒" />
                                <TextBlock Text="  Cart" />
                                <Border Margin="8,0,0,0" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Padding="6,1" MinWidth="22"
                                        Visibility="{Binding HasCartItems, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding CartItemsCount}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentView}" Margin="28,24,28,28" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
