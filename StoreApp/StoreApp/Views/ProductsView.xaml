<UserControl x:Class="StoreApp.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <!-- Toolbar -->
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,16,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,8,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding SearchCommand}" Content="Search" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Command="{Binding ClearFiltersCommand}" Content="Clear" Margin="0,0,8,0" />
                    <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding AddNewCommand}" Content="+ New product" />
                </Grid>
            </Border>

            <!-- Grid -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0">
                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Product" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="6" Background="#F1F5F9" ClipToBounds="True">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Sku}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Brand" Binding="{Binding Brand}" Width="100" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                        <DataGridTextColumn Header="Price" Binding="{Binding EffectivePrice, StringFormat=C}" Width="90" />
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60" />
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource ProductStatusBrush}}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bottom action -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- Editor panel -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Product details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                <TextBlock Text="SKU" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Editing.Sku, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Editing.Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="BRAND" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Editing.Brand, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="DESCRIPTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Editing.Description, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding Editing.Category}" Margin="0,0,6,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Editing.Status}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PRICE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Editing.Price, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Margin="0,0,6,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="DISCOUNT PRICE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Editing.DiscountPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2, TargetNullValue=''}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="STOCK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Editing.Stock, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="IMAGE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Editing.ImageUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding UploadImageCommand}" Content="Browse..." Margin="6,0,0,0" />
                </Grid>
                <Border Margin="0,8,0,0" Width="120" Height="120" HorizontalAlignment="Left" CornerRadius="6" Background="#F1F5F9" ClipToBounds="True">
                    <Image Source="{Binding Editing.ImageUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
