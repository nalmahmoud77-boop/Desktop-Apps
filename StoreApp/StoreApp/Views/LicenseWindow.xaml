<Window x:Class="StoreApp.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StoreApp — Activate license" Height="520" Width="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border CornerRadius="20" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="40" Opacity="0.18" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Margin="32,20,20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource PrimaryGradient}">
                        <TextBlock Text="🔑" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Activate StoreApp" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentStatus}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Click="Minimize_Click" Content="—" FontSize="14" Padding="10,2" />
                    <Button Style="{StaticResource GhostButton}" Click="Close_Click" Content="✕" FontSize="14" Padding="10,2" />
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="32,16,32,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Enter your license key" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Paste the key issued to you. Activation is offline — your license is verified locally."
                               FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Key entry -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="License key" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Format: STORE-XX-XXXXXXXX-XXXXXXXX"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,10" />

                        <TextBox Grid.Row="2" Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                Padding="22,10" Command="{Binding ActivateKeyCommand}" IsDefault="True">
                            <TextBlock Text="Activate" FontWeight="SemiBold" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Messages -->
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Padding="12" CornerRadius="8" Background="#ECFDF5" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InfoMessage, Converter={StaticResource NotNullToVis}}" Value="Visible">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding InfoMessage}" Foreground="#065F46" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                    <Border Padding="12" CornerRadius="8" Background="#FEF2F2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" Value="Visible">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2" Text="License is stored encrypted under %AppData%\StoreApp"
                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,14" />
        </Grid>
    </Border>
</Window>
