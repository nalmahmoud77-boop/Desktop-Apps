<UserControl x:Class="StoreApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Hero -->
        <Border CornerRadius="14" Background="{StaticResource HeroGradient}" Padding="28" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Welcome back 👋" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Here's how your store is doing today." Foreground="#E0E7FF" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Background="#33FFFFFF" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="TODAY" Foreground="#E0E7FF" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding Data.TodayRevenue, StringFormat=C}" Foreground="White" FontWeight="Bold" FontSize="18" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats grid -->
        <UniformGrid Columns="4" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TOTAL REVENUE" Style="{StaticResource SubheadingText}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding Data.TotalRevenue, StringFormat=C}" Style="{StaticResource StatNumber}" Margin="0,8,0,4" />
                    <TextBlock Text="↑ Sales since launch" Foreground="{StaticResource SuccessBrush}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="ORDERS" Style="{StaticResource SubheadingText}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding Data.TotalOrders}" Style="{StaticResource StatNumber}" Margin="0,8,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Data.PendingOrders}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold" />
                        <TextBlock Text=" pending" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="PRODUCTS" Style="{StaticResource SubheadingText}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding Data.TotalProducts}" Style="{StaticResource StatNumber}" Margin="0,8,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Data.LowStockProducts}" Foreground="{StaticResource DangerBrush}" FontWeight="Bold" />
                        <TextBlock Text=" low stock" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="CUSTOMERS" Style="{StaticResource SubheadingText}" FontWeight="Bold" FontSize="11" />
                    <TextBlock Text="{Binding Data.TotalCustomers}" Style="{StaticResource StatNumber}" Margin="0,8,0,4" />
                    <TextBlock Text="Active accounts" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Two columns -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Top Products -->
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Top rated products" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding TopProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="42" Height="42" CornerRadius="6" Background="#F1F5F9" ClipToBounds="True">
                                            <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="⭐" FontSize="11" />
                                                <TextBlock Text="{Binding Rating}" Margin="3,0,8,0" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                                <TextBlock Text="{Binding ReviewsCount, StringFormat={}({0} reviews)}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding EffectivePrice, StringFormat=C}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Recent orders -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Recent orders" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding RecentOrders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding CustomerName}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource OrderStatusBrush}}" Margin="8,0">
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat=C}" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
