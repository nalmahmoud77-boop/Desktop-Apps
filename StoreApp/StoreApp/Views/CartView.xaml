<UserControl x:Class="StoreApp.Views.CartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- Items list -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="20,18,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Your cart" FontSize="20" FontWeight="Bold" />
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                            <Run Text="{Binding TotalItems, Mode=OneWay}" />
                            <Run Text="items in cart" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Clear cart" Command="{Binding ClearCommand}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,20">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="14" Margin="0,0,0,10" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="64" Height="64" CornerRadius="8" Background="#F1F5F9" ClipToBounds="True">
                                                <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13.5" />
                                                <TextBlock Text="{Binding UnitPrice, StringFormat=C}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Content="−"
                                                        Command="{Binding DataContext.DecreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Border Padding="14,0" MinWidth="30" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Quantity}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                                </Border>
                                                <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Content="+"
                                                        Command="{Binding DataContext.IncreaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat=C}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" />

                                            <Button Grid.Column="4" Margin="14,0,0,0" Style="{StaticResource GhostButton}" Content="✕"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Padding="40" CornerRadius="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TotalItems}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🛒" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="Your cart is empty" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                <TextBlock Text="Browse the shop and add some products." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Summary / Checkout -->
        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Checkout" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />

                <TextBlock Text="CUSTOMER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="FullName" />

                <TextBlock Text="PAYMENT METHOD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" />

                <TextBlock Text="DISCOUNT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" />

                <TextBlock Text="NOTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10" />

                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subtotal" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat=C}" />
                    <TextBlock Grid.Row="1" Text="Tax (10%)" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Tax, StringFormat=C}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Text="Shipping" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Shipping, StringFormat=C}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="3" Text="Discount" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Discount, StringFormat=C}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="4" Text="Total" FontWeight="Bold" FontSize="16" Margin="0,12,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Total, StringFormat=C}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource PrimaryBrush}" Margin="0,12,0,0" />
                </Grid>

                <Button Style="{StaticResource PrimaryButton}" Padding="0,12" Margin="0,18,0,0" Command="{Binding CheckoutCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="✓ Place order" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Free shipping on orders over $100" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
