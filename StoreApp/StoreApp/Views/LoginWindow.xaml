<Window x:Class="StoreApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StoreApp — Sign in" Height="620" Width="980"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize">
    <Border CornerRadius="20" Background="White">
        <Border.Effect>
            <DropShadowEffect Color="#000" BlurRadius="40" Opacity="0.18" ShadowDepth="0" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- Left hero -->
            <Border CornerRadius="20,0,0,20" Background="{StaticResource LoginGradient}">
                <Grid Margin="48">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#33FFFFFF">
                            <TextBlock Text="🛒" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="StoreApp" Foreground="White" FontSize="22" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Welcome back ✨" Foreground="White" FontSize="36" FontWeight="Bold" />
                        <TextBlock Text="Manage your products, customers, and orders all in one place. Modern, fast, and built for growing stores."
                                   Foreground="#E0E7FF" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22" MaxWidth="400" HorizontalAlignment="Left" />

                        <StackPanel Margin="0,32,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" Width="22" />
                                <TextBlock Text="Catalog &amp; inventory management" Foreground="#E0E7FF" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" Width="22" />
                                <TextBlock Text="Orders, payments &amp; shipping" Foreground="#E0E7FF" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" Width="22" />
                                <TextBlock Text="Customer profiles &amp; history" Foreground="#E0E7FF" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="✓" Foreground="White" FontWeight="Bold" Width="22" />
                                <TextBlock Text="Sales analytics dashboard" Foreground="#E0E7FF" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="© 2026 StoreApp Demo" Foreground="#C7D2FE" FontSize="11" />
                </Grid>
            </Border>

            <!-- Right form -->
            <Grid Grid.Column="1" Margin="48,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Click="Minimize_Click" Content="—" FontSize="14" Padding="10,2" />
                    <Button Style="{StaticResource GhostButton}" Click="Close_Click" Content="✕" FontSize="14" Padding="10,2" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Sign in" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="Use your store credentials to continue." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,28" />

                    <TextBlock Text="USERNAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,6" />
                    <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown" />

                    <Border Margin="0,16,0,0" Padding="12" CornerRadius="8" Background="#FEF2F2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage, Converter={StaticResource NotNullToVis}}" Value="Visible">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12" />
                    </Border>

                    <Button Margin="0,24,0,0" Style="{StaticResource PrimaryButton}" Padding="0,12"
                            Command="{Binding LoginCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Sign in" FontWeight="SemiBold" />
                            <TextBlock Text="  →" />
                        </StackPanel>
                    </Button>

                    <Border Margin="0,28,0,0" Padding="14" CornerRadius="8" Background="#F1F5F9">
                        <StackPanel>
                            <TextBlock Text="Demo credentials" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="Username: admin   /   Password: admin" FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Powered by WPF · MVVM · EF Core" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            </Grid>
        </Grid>
    </Border>
</Window>
