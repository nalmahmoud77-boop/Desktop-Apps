<UserControl x:Class="StoreApp.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Filter bar -->
        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Margin="0,0,10,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Tag="Search products..." />
                <ComboBox Grid.Column="1" Margin="0,0,10,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TargetNullValue='All categories', FallbackValue='All categories'}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" Margin="0,0,10,0" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Content="Search" />
            </Grid>
        </Border>

        <!-- Product grid -->
        <ItemsControl ItemsSource="{Binding Products}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="240" Margin="0,0,16,16" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border Height="180" CornerRadius="12,12,0,0" Background="#F1F5F9" ClipToBounds="True">
                                    <Image Source="{Binding ImageUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill" />
                                </Border>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" CornerRadius="6" Padding="6,2"
                                        Background="{StaticResource DangerBrush}"
                                        Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="SALE" Foreground="White" FontWeight="Bold" FontSize="10" />
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="6" Padding="6,2"
                                        Background="{StaticResource SurfaceBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" FontSize="10" />
                                        <TextBlock Text="{Binding Rating}" FontSize="11" FontWeight="Bold" Margin="2,0,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                <TextBlock Text="{Binding Brand}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" Margin="0,2,0,8" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding EffectivePrice, StringFormat=C}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}" />
                                    <TextBlock Text="{Binding Price, StringFormat=C}" FontSize="11" Margin="6,2,0,0" Foreground="{StaticResource MutedBrush}"
                                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.TextDecorations>
                                            <TextDecoration Location="Strikethrough" />
                                        </TextBlock.TextDecorations>
                                    </TextBlock>
                                </StackPanel>
                                <Button Style="{StaticResource PrimaryButton}" Padding="0,9"
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding InStock}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🛒" />
                                        <TextBlock Text="  Add to cart" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Out of stock" Foreground="{StaticResource DangerBrush}" FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           Visibility="{Binding InStock, Converter={StaticResource BoolToVisInverted}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
