<UserControl x:Class="StoreApp.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}" Text="Filter and manage all customer orders" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Margin="0,0,8,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TargetNullValue='All statuses', FallbackValue='All statuses'}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderNumber}" Width="110" />
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat=g}" Width="140" />
                        <DataGridTextColumn Header="Items" Binding="{Binding ItemsCount}" Width="60" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="100" />
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource OrderStatusBrush}}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentMethod}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Order details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                <StackPanel Visibility="{Binding Selected, Converter={StaticResource NotNullToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.OrderNumber}" FontWeight="Bold" FontSize="20" />
                            <TextBlock Text="{Binding Selected.CustomerName}" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding Selected.OrderDate, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusBadge}" Background="{Binding Selected.Status, Converter={StaticResource OrderStatusBrush}}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selected.Status}" Style="{StaticResource BadgeText}" />
                        </Border>
                    </Grid>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,12" />

                    <TextBlock Text="ITEMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                    <ItemsControl ItemsSource="{Binding Selected.Items}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProductName}" FontSize="13" />
                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                            <Run Text="{Binding Quantity}" /><Run Text=" × " /><Run Text="{Binding UnitPrice, StringFormat=C}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat=C}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Subtotal" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Selected.Subtotal, StringFormat=C}" />
                        <TextBlock Grid.Row="1" Text="Tax" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Tax, StringFormat=C}" />
                        <TextBlock Grid.Row="2" Text="Shipping" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.Shipping, StringFormat=C}" />
                        <TextBlock Grid.Row="3" Text="Discount" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.Discount, StringFormat=C}" />
                        <TextBlock Grid.Row="4" Text="Total" FontWeight="Bold" FontSize="16" Margin="0,8,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.Total, StringFormat=C}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,0" />
                    </Grid>

                    <TextBlock Text="UPDATE STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,8" />
                    <ItemsControl ItemsSource="{Binding StatusOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,6,6"
                                        Command="{Binding DataContext.UpdateStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Content="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource DangerButton}" Content="Cancel order" Command="{Binding CancelOrderCommand}" Margin="0,12,0,0" />
                </StackPanel>

                <TextBlock Text="Select an order to see its details." Foreground="{StaticResource MutedBrush}" FontStyle="Italic"
                           Visibility="{Binding Selected, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
