<UserControl x:Class="StoreApp.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <StackPanel Margin="0,0,16,0">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Margin="0,0,8,0" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding SearchCommand}" Content="Search" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding AddNewCommand}" Content="+ New customer" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding Selected}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Customer" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryGradient}">
                                            <TextBlock Text="{Binding FullName}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Email}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="160" />
                        <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120" />
                        <DataGridTextColumn Header="Country" Binding="{Binding Country}" Width="110" />
                        <DataGridTextColumn Header="Orders" Binding="{Binding OrdersCount}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource DangerButton}" Content="Delete" Command="{Binding DeleteCommand}" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Customer details" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />

                <TextBlock Text="FULL NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Editing.FullName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="EMAIL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Editing.Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="PHONE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Editing.Phone, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="ADDRESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                <TextBox Text="{Binding Editing.Address, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CITY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Editing.City, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="COUNTRY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Editing.Country, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
