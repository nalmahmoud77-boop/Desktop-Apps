<Window x:Class="StoreApp.KeyGen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StoreApp KeyGen (internal)" Height="380" Width="640"
        WindowStartupLocation="CenterScreen" Background="#0F172A"
        TextElement.Foreground="#F8FAFC" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="StoreApp KeyGen" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="Internal tool — do not ship to customers." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="MonthlyButton" Click="GenerateMonthly_Click" Content="Monthly (30 days)"
                    Padding="18,10" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <Button x:Name="YearlyButton" Click="GenerateYearly_Click" Content="Yearly (1 year)"
                    Padding="18,10" Margin="0,0,8,0" Background="#6366F1" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <Button x:Name="LifetimeButton" Click="GenerateLifetime_Click" Content="Lifetime"
                    Padding="18,10" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Generated key" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4" />

        <TextBox Grid.Row="3" x:Name="KeyTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="14"
                 Padding="10" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="CopyButton" Click="Copy_Click" Content="Copy" IsEnabled="False"
                    Padding="14,8" Margin="0,0,8,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <Button x:Name="SaveButton" Click="Save_Click" Content="Save to file..." IsEnabled="False"
                    Padding="14,8" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#94A3B8" FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
